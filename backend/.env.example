# MongoDB connection string (e.g. from MongoDB Atlas Free Tier)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name
DB_NAME=ameya_consultancy

# Allowed CORS origins (comma-separated, or * for public access)
CORS_ORIGINS=*

# Timezone anchor for consultations
APP_TZ=Asia/Kolkata

# Optional: Google Calendar & Meet integration (set to true only when Google OAuth credentials exist)
GOOGLE_MEET_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
